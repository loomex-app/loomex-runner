      "operation": "chat_context.create"
    },
    "builder.start": {
      "method": "workflow.operations.get",
      "identity": "idempotencyKey",
      "operation": "builder.start"
    },
    "editor.start": {
      "method": "workflow.operations.get",
      "identity": "idempotencyKey",
      "operation": "editor.start"
    },
    "persona.roles.create": {
      "method": "personas.operations.get",
      "identity": "idempotencyKey",
      "operation": "role.create"
    },
    "personas.create": {
      "method": "personas.operations.get",
      "identity": "idempotencyKey",
      "operation": "person.create"
    }
  }
}
