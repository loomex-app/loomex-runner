{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loomex.local-control/v2",
  "title": "Loomex local control v2",
  "$defs": {
    "validationIssue": {
      "type": "object",
      "required": ["code", "message", "nextAction"],
      "properties": {
        "code": {
          "enum": [
            "RUN_INPUT_SCHEMA_INVALID",
            "RUN_VALIDATION_EXECUTION_POLICY_INVALID",
            "UNSUPPORTED_CAPABILITY",
            "RUN_VALIDATION_EXECUTION_ROOT_REQUIRED",
            "RUN_VALIDATION_RUNNER_UNAVAILABLE",
            "RUN_VALIDATION_PROVIDER_UNSUPPORTED",
            "RUN_VALIDATION_PROVIDER_INVALID",
            "RUN_VALIDATION_POLICY_DENIED",
            "RUN_VALIDATION_POLICY_REQUIRED",
            "RUN_VALIDATION_FAILED"
          ]
        },
        "message": {
          "enum": [
            "Workflow inputs do not match the required schema.",
            "The workflow execution policy does not support a required capability.",
            "This workflow requires a prepared local runner execution root.",
            "The required local runner is not connected.",
            "The selected provider does not support a required workflow capability.",
            "The workflow selects a provider that cannot run this work.",
            "The execution policy does not allow a required workflow capability.",
            "A required workflow capability policy has not been configured.",
            "The workflow has a validation issue that must be reviewed."
          ]
        },
        "nextAction": {
          "enum": [
            "correct_workflow_inputs",
            "update_workflow_definition",
            "prepare_runner_execution",
            "connect_runner",
            "choose_supported_provider",
            "allow_capability",
            "configure_capability_policy",
            "review_workflow_validation"
          ]
        },
        "nodeId": {"type": "string", "format": "uuid"},
        "nodeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "protocol": {
          "const": "loomex.local-control/v2"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "enum": [
            "protocol.negotiate",
            "status.get",
            "auth.status",
            "auth.login",
            "auth.poll",
            "auth.logout",
            "organizations.list",
            "organizations.select",
            "workspaces.list",
            "workspaces.grant",
            "workspaces.revoke",
            "workflows.list",
            "workflows.get",
            "workflows.create",
            "workflows.update",
            "workflows.validate",
            "workflows.publish",
            "workflows.activate",
            "builder.catalog",
            "builder.validate",
            "builder.prepare",
            "builder.get",
            "builder.respond",
            "builder.finalize",
            "editor.prepare",
            "editor.respond",
            "editor.finalize",
            "runs.prepare",
            "runs.commit",
            "runs.list",
            "runs.get",
            "runs.wait",
            "runs.events",
            "runs.result",
            "runs.cancel",
            "runs.delete",
            "interactions.list",
            "interactions.get",
            "interactions.respond",
            "interactions.decide",
            "artifacts.list",
            "artifacts.read",
            "artifacts.download",
            "responses.read",
            "responses.delete",
            "daemon.drain",
            "builder.commit",
            "editor.commit"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "result"
      ],
      "properties": {
        "protocol": {
          "const": "loomex.local-control/v2"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "error"
      ],
      "properties": {
        "protocol": {
          "const": "loomex.local-control/v2"
        },
        "id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "correlationId",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid"
            },
            "retryable": {
              "type": "boolean"
            },
            "data": {
              "type": "object",
              "required": ["validationIssueVersion", "validationIssues"],
              "properties": {
                "validationIssueVersion": {"const": "v1"},
                "validationIssues": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {"$ref": "#/$defs/validationIssue"}
                }
              },
              "additionalProperties": false
            }
          },
          "allOf": [
            {
              "if": {"required": ["data"]},
              "then": {"properties": {"code": {"const": "RUN_VALIDATION_FAILED"}}}
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
