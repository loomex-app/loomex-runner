{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loomex.local-control/v2",
  "title": "Loomex local control v2",
  "$defs": {
    "validationIssue": {
      "type": "object",
      "required": [
        "code",
        "message",
        "nextAction"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "nextAction": {
          "type": "string"
        },
        "nodeIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "code": {
                  "const": "RUN_INPUT_SCHEMA_INVALID"
                },
                "message": {
                  "const": "Workflow inputs do not match the required schema."
                },
                "nextAction": {
                  "const": "correct_workflow_inputs"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_EXECUTION_POLICY_INVALID"
                },
                "message": {
                  "const": "The workflow execution policy does not support a required capability."
                },
                "nextAction": {
                  "const": "update_workflow_definition"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "UNSUPPORTED_CAPABILITY"
                },
                "message": {
                  "const": "The workflow execution policy does not support a required capability."
                },
                "nextAction": {
                  "const": "update_workflow_definition"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_EXECUTION_ROOT_REQUIRED"
                },
                "message": {
                  "const": "This workflow requires a prepared local runner execution root."
                },
                "nextAction": {
                  "const": "prepare_runner_execution"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_RUNNER_UNAVAILABLE"
                },
                "message": {
                  "const": "The required local runner is not connected."
                },
                "nextAction": {
                  "const": "connect_runner"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_PROVIDER_UNSUPPORTED"
                },
                "message": {
                  "const": "The selected provider does not support a required workflow capability."
                },
                "nextAction": {
                  "const": "choose_supported_provider"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_PROVIDER_INVALID"
                },
                "message": {
                  "const": "The workflow selects a provider that cannot run this work."
                },
                "nextAction": {
                  "const": "choose_supported_provider"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_POLICY_DENIED"
                },
                "message": {
                  "const": "The execution policy does not allow a required workflow capability."
                },
                "nextAction": {
                  "const": "allow_capability"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_POLICY_REQUIRED"
                },
                "message": {
                  "const": "A required workflow capability policy has not been configured."
                },
                "nextAction": {
                  "const": "configure_capability_policy"
                }
              }
            },
            {
              "properties": {
                "code": {
                  "const": "RUN_VALIDATION_FAILED"
                },
                "message": {
                  "const": "The workflow has a validation issue that must be reviewed."
                },
                "nextAction": {
                  "const": "review_workflow_validation"
                }
              }
            }
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "protocol": {
          "const": "loomex.local-control/v2"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "enum": [
            "protocol.negotiate",
            "status.get",
            "auth.status",
            "auth.login",
            "auth.poll",
            "auth.logout",
            "organizations.list",
            "organizations.select",
            "workspaces.list",
            "workspaces.grant",
            "workspaces.revoke",
            "workflows.list",
            "workflows.get",
            "workflows.create",
            "workflows.update",
            "workflows.validate",
            "workflows.publish",
            "workflows.activate",
            "builder.catalog",
            "builder.validate",
            "builder.prepare",
            "builder.get",
            "builder.respond",
            "builder.finalize",
            "editor.prepare",
            "editor.respond",
            "editor.finalize",
            "runs.prepare",
            "runs.commit",
            "runs.start_handoff.issue",
            "runs.start_handoff.restore",
            "runs.start_handoff.get",
            "runs.start_handoff.commit",
            "runs.list",
            "runs.get",
            "runs.wait",
            "runs.events",
            "runs.result",
            "runs.cancel",
            "runs.delete",
            "interactions.list",
            "interactions.get",
            "interactions.respond",
            "interactions.decide",
            "artifacts.list",
            "artifacts.read",
            "artifacts.download",
            "responses.read",
            "responses.delete",
            "daemon.drain",
            "builder.commit",
            "editor.commit",
            "preparations.get",
            "presentation.delivery.get",
            "presentation.delivery.begin",
            "presentation.delivery.settle",
            "presentation.sessions.create",
            "presentation.sessions.get",
            "presentation.sessions.restore",
            "presentation.sessions.update",
            "presentation.sessions.delete",
            "presentation.operations.get",
            "presentation.operations.settle",
            "interactions.draft.get",
            "interactions.draft.update",
            "interactions.draft.delete"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "result"
      ],
      "properties": {
        "protocol": {
          "const": "loomex.local-control/v2"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "error"
      ],
      "properties": {
        "protocol": {
          "const": "loomex.local-control/v2"
        },
        "id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "correlationId",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid"
            },
            "retryable": {
              "type": "boolean"
            },
            "data": {
              "type": "object",
              "required": [
                "validationIssueVersion",
                "validationIssues"
              ],
              "properties": {
                "validationIssueVersion": {
                  "const": "v1"
                },
                "validationIssues": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "$ref": "#/$defs/validationIssue"
                  }
                }
              },
              "additionalProperties": false
            },
            "recovery": {
              "type": "string",
              "enum": [
                "correct_input",
                "retry_exact_operation",
                "reconcile_outcome",
                "refresh_authority",
                "unavailable"
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "not_dispatched",
                "rejected",
                "unknown",
                "completed"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "data"
                ]
              },
              "then": {
                "properties": {
                  "code": {
                    "const": "RUN_VALIDATION_FAILED"
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
