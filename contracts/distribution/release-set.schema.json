{
  "$comment": "Semantic verification also requires canonical deployment-specific origins and exact inventory-bound runner deployment metadata; local-development accepts HTTP loopback only, cloud-preview requires HTTPS DNS origins. Exact source/pair/artifact evidence remains mandatory.",
  "$defs": {
    "asset": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "pattern": "^[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "maximum": 2147483648,
          "minimum": 1,
          "type": "integer"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "file",
        "url",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "component": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "manifestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "releaseTag": {
          "type": "string"
        },
        "repository": {
          "enum": [
            "loomex-app/loomex-runner",
            "loomex-app/loomex-codex-plugin"
          ]
        },
        "sourceRevision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "version",
        "sourceRevision",
        "repository",
        "releaseTag",
        "manifestSha256",
        "asset"
      ],
      "type": "object"
    }
  },
  "$id": "app.loomex.release-set/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "$ref": "#/$defs/component"
        },
        "runner": {
          "$ref": "#/$defs/component"
        }
      },
      "required": [
        "runner",
        "plugin"
      ],
      "type": "object"
    },
    "deployment": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "apiOrigin": {
              "format": "uri",
              "type": "string"
            },
            "profile": {
              "const": "cloud-preview"
            }
          },
          "required": [
            "profile",
            "apiOrigin"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "apiOrigin": {
              "format": "uri",
              "type": "string"
            },
            "profile": {
              "const": "local-development"
            },
            "webAppOrigin": {
              "format": "uri",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "profile",
            "apiOrigin",
            "webAppOrigin"
          ],
          "type": "object"
        }
      ]
    },
    "developmentOnly": {
      "const": true
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "backendSourceRevision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "passed": {
          "const": true
        }
      },
      "required": [
        "asset",
        "backendSourceRevision",
        "passed"
      ],
      "type": "object"
    },
    "installer": {
      "$ref": "#/$defs/asset"
    },
    "platform": {
      "const": "darwin-arm64"
    },
    "protocolVersion": {
      "const": "loomex.local-control/v2"
    },
    "releaseTag": {
      "pattern": "^(preview-)?runner-v[0-9]+\\.[0-9]+\\.[0-9]+-plugin-v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "schema": {
      "const": "app.loomex.release-set/v2"
    }
  },
  "required": [
    "schema",
    "releaseTag",
    "platform",
    "developmentOnly",
    "protocolVersion",
    "components",
    "evidence",
    "installer",
    "deployment"
  ],
  "title": "Frozen paired unsigned preview release set",
  "type": "object"
}
